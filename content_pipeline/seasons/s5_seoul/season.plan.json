    ]
  },
  "outro": [
    "Bun-i's first note lies under all the others.",
    "The letters she learned in 1446 are read freely again."
  ],
  "finale": [
    "Seoul keeps its story in its letters.",
    "This time, you read it note by note."
  ],
  "languageArc": [
    "Act 1: how the letters are made, place words (under, next to, on), lunar months and years.",
    "Act 2: before and after, times and dates, reading two reports side by side.",
    "Act 3: numbers in notes, words that mean more than one thing, and the meaning of gwangbok."
  ],
