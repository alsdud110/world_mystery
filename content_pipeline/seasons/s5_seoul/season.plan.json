  "prologue": {
    "city": "Seoul is very old.\nIts story is full of secrets.",
    "cases": [
      "A wet note waits by a turtle ship.",
      "A lifting machine will not lift.",
      "Logs for the palace go missing.",
      "And the palace lights go dark."
    ],
    "separate": [
      "They look like different cases.",
      "But a good detective\nputs the pieces together."
    ],
    "question": "Who keeps writing the notes?",
    "bigger": "Every note has\nthe same small water drop.",
    "promise": [
      "Find the notes.",
      "Read the letters.",
      "Find the keepers."
    ],
    "firstCase": {
      "picture": "assets/seasons/season_05_seoul/cover/kings_study.webp",
      "line": "Your first case starts\nin old Hanyang."
    },
