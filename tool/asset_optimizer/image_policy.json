  "twins": {
    "about": "Two pictures of one folder, of one size and one of these kinds, alike at this likeness (luma over grey, SSIM at 128 px): variants a puzzle tells apart, so both are 'puzzle'. Portraits and title variants are not puzzles.",
    "minLikeness": 0.8,
    "kinds": ["evidence", "document"]
  },
  "keep": [
    { "prefix": "assets/branding/", "why": "flutter_native_splash and flutter_launcher_icons read these as PNG" }
