{
  // World Mystery: one app on Android and iOS,
  //   com.worldmystery.app ("World Mystery").
  // Pick the device in the status bar (an Android emulator or an iOS
  // simulator such as iPhone 17 Pro). An Android release build needs the
  // upload key (android/key.properties, see android/app/build.gradle.kts).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "World Mystery (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      // Downloaded seasons' pictures read from this folder (no R2) on a
      // simulator; on a phone use the "(debug, R2)" entry.
      "args": ["--dart-define=SEASON_PACK_DIR=${workspaceFolder}"]
    },
    {
      "name": "World Mystery (debug, R2)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "args": ["--dart-define=ASSET_SOURCE=r2"]
    },
    {
      "name": "World Mystery (profile)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "profile"
    },
    {
      "name": "World Mystery (release, no operator tools)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "release"
    }
  ]
}
